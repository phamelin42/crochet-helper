#!/bin/sh
# Garde-fou : rien ne part vers GitHub sans que lint, format, tests et build
# soient verts sur ce poste. Une PR ouverte sur une branche rouge coute un
# aller-retour de CI et une relecture pour rien.
#
# Branche par `tools/installer-hooks.mjs` (script npm `prepare`), qui pose
# `core.hooksPath` sur `.githooks`.
#
# Pour passer outre une fois, en connaissance de cause : git push --no-verify

set -u

# Sur un runner, la CI fait deja ce travail sur un checkout propre.
if [ "${CI:-}" = "true" ]; then
  exit 0
fi

# Une suppression de branche (sha local a zero) ne publie aucun code.
a_pousser=0
while read -r _ref_local sha_local _ref_distant _sha_distant; do
  case "$sha_local" in
    *[!0]*) a_pousser=1 ;;
  esac
done
if [ "$a_pousser" -eq 0 ]; then
  exit 0
fi

echo "pre-push : npm run verify (lint, format, tests, build + pre-rendu)."
echo "           Compter deux a trois minutes. Pour sauter : git push --no-verify"
echo ""

if npm run verify; then
  echo ""
  echo "pre-push : verify est vert, push en cours."
  exit 0
fi

echo "" >&2
echo "pre-push : verify a echoue, push annule." >&2
echo "           Corrige la cause. Ne desactive ni une regle de lint, ni un" >&2
echo "           test, ni un controle de build pour faire passer la commande." >&2
exit 1
