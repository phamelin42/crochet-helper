#!/bin/sh
# Garde-fou : rien ne part vers GitHub sans que TOUT ce que verifie le job CI
# soit vert sur ce poste. `npm run verify` seul ne suffit pas — il ignore
# l'audit Playwright (axe, reflow, performance, e2e), que la CI lance juste
# apres le build. Un hook qui s'arreterait a `verify` laisserait donc encore
# passer une PR rouge : c'est arrive des le premier essai.
#
# Branche par `tools/installer-hooks.mjs` (script npm `prepare`), qui pose
# `core.hooksPath` sur `.githooks`.
#
# Pour passer outre une fois, en connaissance de cause : git push --no-verify

set -u

# Sur un runner, la CI fait deja ce travail sur un checkout propre.
if [ "${CI:-}" = "true" ]; then
  exit 0
fi

# Une suppression de branche (sha local a zero) ne publie aucun code.
a_pousser=0
while read -r _ref_local sha_local _ref_distant _sha_distant; do
  case "$sha_local" in
    *[!0]*) a_pousser=1 ;;
  esac
done
if [ "$a_pousser" -eq 0 ]; then
  exit 0
fi

echo "pre-push : npm run verify:ci — tout ce que verifie le job CI :"
echo "           lint, format, tests unitaires, tests des outils, build avec"
echo "           pre-rendu, puis l'audit Playwright (axe WCAG AA, reflow"
echo "           320 px, CLS/LCP, analytics, permalien)."
echo "           Compter cinq a six minutes. Pour sauter : git push --no-verify"
echo ""

if npm run verify:ci; then
  echo ""
  echo "pre-push : verify:ci est vert, push en cours."
  exit 0
fi

echo "" >&2
echo "pre-push : verify:ci a echoue, push annule." >&2
echo "           Corrige la cause. Ne desactive ni une regle de lint, ni un" >&2
echo "           test, ni un controle de build pour faire passer la commande." >&2
echo "" >&2
echo "           Navigateur manquant ? npx playwright install chromium" >&2
exit 1
