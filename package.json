{
  "name": "pattern-reader",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/generate-sitemap.mjs && node tools/strip-event-dispatch.mjs && node tools/preload-font.mjs && ngsw-config dist/fil-patterns/browser ngsw-config.json / && node tools/check-csp.mjs && node tools/check-prerender.mjs && node tools/check-styles.mjs && node tools/check-ngsw.mjs && node tools/check-showcase.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:app": "ng build",
    "test:ci": "ng test --no-watch",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:a11y": "ng build && playwright test",
    "verify": "npm run lint && npm run format:check && npm run test:ci && npm run test:tools && npm run build",
    "prepare": "node tools/installer-hooks.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "express": "^5.1.0",
    "pdfjs-dist": "^6.3.289",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
