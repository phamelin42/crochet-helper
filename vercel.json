{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/fil-patterns/browser",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' https://analytics.patternreader.com; font-src 'self'; connect-src 'self' https://analytics.patternreader.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "crochet-helper.phamelin.fr"
        }
      ],
      "destination": "https://patternreader.com/$1",
      "permanent": true
    },
    {
      "source": "/lecteur",
      "destination": "/fr",
      "permanent": true
    },
    {
      "source": "/en/reader",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/glossaire",
      "destination": "/fr/glossaire",
      "permanent": true
    },
    {
      "source": "/en/glossary",
      "destination": "/glossary",
      "permanent": true
    },
    {
      "source": "/bien-formater-son-patron",
      "destination": "/fr/bien-formater-son-patron",
      "permanent": true
    },
    {
      "source": "/en/format-your-pattern",
      "destination": "/format-your-pattern",
      "permanent": true
    }
  ]
}
